{
  "permissions": {
    "deny": [
      "Read(./**/.venv/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.pytest_cache/**)",
      "Bash(cd .claude/worktrees/*)",
      "Bash(cd ./.claude/worktrees/*)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(rtk git *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/usage-watchdog.sh\"",
            "timeout": 10,
            "suppressOutput": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/usage-probe.sh\"",
    "refreshInterval": 60
  }
}
