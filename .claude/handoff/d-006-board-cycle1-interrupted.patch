+
+function clearKeyboardArm() {
+  if (!graphState.keyboardArmed) return;
+  const prev = portElFor(graphState.keyboardArmed.id, "out");
+  if (prev) {
+    prev.classList.remove("port--armed");
+    prev.setAttribute("aria-pressed", "false");
+  }
