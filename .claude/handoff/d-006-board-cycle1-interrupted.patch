+
+function handleInActivate(id) {
+  if (!graphState.keyboardArmed) {
+    setStatus("Click (or press Enter on) an output port first, then an input port, to connect two nodes.");
+    return;
+  }
+  const { id: fromId, kind: fromKind } = graphState.keyboardArmed;
+  clearKeyboardArm();
+  attemptConnect(fromId, fromKind, id);
