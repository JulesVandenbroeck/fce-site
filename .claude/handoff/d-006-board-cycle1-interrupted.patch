+        f"{len(facts)} reveal/press-animated elements checked under prefers-reduced-motion: reduce",
+        ok,
+        f"{len(bad)} still animating or not at full opacity",
+    )
+    for f in bad[:10]:
+        print(f"       still animating: {f}")
+    browser.close()
+    return ok
