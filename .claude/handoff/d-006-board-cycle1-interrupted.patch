+// live-reorder would do on every step, since the card holds the very
+// element pointer capture was set on) empirically drops that capture in
+// Chromium, silencing every pointermove after the first live reorder even
+// though the captured element never leaves the document. Tracking the
+// pointer position without mutating the DOM until release side-steps that
+// entirely, and still lands on the same final slot a live reorder would. */
+function startReorderDrag(id, handleEl, ev) {
+  if (ev.button !== undefined && ev.button !== 0) return;
+  ev.preventDefault();
+  handleEl.setPointerCapture(ev.pointerId);
+  const card = handleEl.closest(".node-card");
+  const list = card.parentElement;
+  let moved = false;
+  let lastClientY = ev.clientY;
