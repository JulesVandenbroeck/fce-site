+
+function addNode(kind, subtitle) {
+  const id = `n${graphState.nextId}`;
+  graphState.nextId += 1;
+  graphState.nodes.set(id, { kind });
+  const meta = KIND_BY_NAME[kind];
+  const li = buildNodeEl(id, kind, subtitle);
